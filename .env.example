# Microsoft Entra app registration (see README)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Where the app is reachable, no trailing slash. Local: http://localhost:3000
APP_URL=http://localhost:3000
# The only mailbox allowed to sign in
ALLOWED_EMAIL=you@hotmail.com
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 24  (the scheduler sends it as a Bearer token)
CRON_SECRET=
# Local file DB by default; use a Turso URL + token when deployed on Vercel
# Local development only. On Vercel this must be a libsql:// URL from Turso, or data is wiped on every deploy.
TURSO_DATABASE_URL=file:easymail.db
TURSO_AUTH_TOKEN=
# Optional: LLM-written digest summaries (email snippets are sent to Anthropic)
ANTHROPIC_API_KEY=
